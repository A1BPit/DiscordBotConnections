# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID from the General Information page
CLIENT_ID=your-application-id-here

# OAuth2 client secret from the OAuth2 page (needed for the Activity login)
CLIENT_SECRET=your-oauth2-client-secret-here

# Same as CLIENT_ID — exposed to the Activity frontend by Vite
VITE_DISCORD_CLIENT_ID=your-application-id-here

# OAuth2 redirect URI — must match a Redirect added in the Developer Portal (default below)
OAUTH_REDIRECT_URI=https://127.0.0.1

# Your Discord server ID — register slash commands to one guild for instant updates
GUILD_ID=your-server-id-here

# Port for the Activity API/web server (default 3001)
PORT=3001

# Optional: how long games/leaderboards live, in hours (default 24, max enforced 24).
# Use a small value like 0.05 (3 minutes) to test expiry quickly.
GAME_TTL_HOURS=24
